# --- Build ---
rust/target/
**/*.rs.bk
*.pdb

# --- Maintainers' local notes ---
# Notes kept beside the docs stay on the maintainer's machine; only the pages
# below are part of the repository.
/docs/*.md
!/docs/architecture.md
!/docs/release-notes.md

# --- Editor settings ---
.vscode/
.idea/

# --- Local scratch ---
check*.txt
tools*.txt
tests*.txt
rename*.txt
/t*.txt
/w.txt
*.local.toml
.DS_Store

# Throwaway build logs / scratch
_scratch/
*.buildlog.txt

# A Windows test run can create this directory when the variable is not
# expanded.
%SystemDrive%/
