# --- Build ---
rust/target/
**/*.rs.bk
*.pdb

# Local cargo settings (linker, sccache path): machine-specific.
rust/.cargo/config.toml

# --- Maintainers' local notes ---
# Notes kept beside the docs stay on the maintainer's machine; only the pages
# below are part of the repository.
/docs/*.md
!/docs/architecture.md
!/docs/release-notes.md

# --- Editor and OS files ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Local scratch: build logs ---
_scratch/
*.buildlog.txt

# A Windows test run can create this directory when the variable is not
# expanded.
%SystemDrive%/
